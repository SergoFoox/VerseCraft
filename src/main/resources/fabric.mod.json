{
  "schemaVersion": 1,
  "id": "versecraft",
  "version": "${version}",
  "name": "VerseCraft",
  "description": "VerseCraft expands vanilla Minecraft with new decorative blocks, plants, food, and small details — all designed to fit seamlessly into the original game style.",
  "authors": [
    "SergoFox",
    "Zozozrob"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/versecraft",
    "sources": "https://github.com/SergoFox123/VerseCraft",
    "issues": "https://github.com/SergoFox123/VerseCraft/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/versecraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sergofoox.versecraft.VerseCraft"
    ],
    "client": [
      "net.sergofoox.versecraft.VerseCraftClientInitializer"
    ],
    "fabric-datagen": [
      "net.sergofoox.versecraft.VerseCraftDataGenerator"
    ]
  },
  "mixins": [
    "versecraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3-",
    "java": ">=25",
    "fabric-api": "*"
  }
}